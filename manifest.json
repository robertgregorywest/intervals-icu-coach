{
  "manifest_version": "0.4",
  "version": "0.7.0",
  "name": "intervals-icu-mcp",
  "display_name": "Intervals.icu",
  "description": "Access your Intervals.icu training data — activities, calendar, fitness metrics, power curves, workout planning, and a managed library of saved workouts that can act as a coaching template store.",
  "server": {
    "type": "node",
    "entry_point": "dist/mcp/stdio.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/dist/mcp/stdio.js"],
      "env": {
        "INTERVALS_API_KEY": "${user_config.intervals_api_key}",
        "INTERVALS_ATHLETE_ID": "${user_config.intervals_athlete_id}"
      }
    }
  },
  "user_config": {
    "intervals_api_key": {
      "type": "string",
      "title": "Intervals.icu API Key",
      "description": "Your Intervals.icu API key (Settings → API)",
      "required": true,
      "sensitive": true
    },
    "intervals_athlete_id": {
      "type": "string",
      "title": "Athlete ID",
      "description": "Your Intervals.icu athlete ID, or leave blank to use the authenticated user",
      "required": false,
      "default": "0"
    }
  },
  "tools": [
    {
      "name": "get_athlete"
    },
    {
      "name": "get_activities"
    },
    {
      "name": "get_activity"
    },
    {
      "name": "get_activity_laps"
    },
    {
      "name": "get_activity_streams"
    },
    {
      "name": "get_events"
    },
    {
      "name": "get_event"
    },
    {
      "name": "update_event"
    },
    {
      "name": "delete_events"
    },
    {
      "name": "create_workout"
    },
    {
      "name": "schedule_library_workout"
    },
    {
      "name": "create_strength_workout"
    },
    {
      "name": "list_workout_library"
    },
    {
      "name": "get_workout_library_item"
    },
    {
      "name": "delete_workout_library_item"
    },
    {
      "name": "get_wellness"
    },
    {
      "name": "get_fitness_summary"
    },
    {
      "name": "get_power_curve"
    },
    {
      "name": "get_aerobic_decoupling"
    },
    {
      "name": "compare_intervals"
    },
    {
      "name": "compare_planned_vs_actual"
    },
    {
      "name": "compare_intensity_distribution"
    },
    {
      "name": "get_execution_digest"
    },
    {
      "name": "compute_power_profile"
    },
    {
      "name": "compute_track_lap_power"
    },
    {
      "name": "write_track_runs"
    },
    {
      "name": "create_drivetrain_speed_fit"
    },
    {
      "name": "get_training_week_summary"
    },
    {
      "name": "get_coaching_context"
    },
    {
      "name": "forecast_training_load"
    },
    {
      "name": "sync_workout_library"
    },
    {
      "name": "list_track_sessions"
    },
    {
      "name": "get_track_session"
    },
    {
      "name": "compare_track_sessions"
    }
  ],
  "author": {
    "name": "Rob West",
    "email": "robertgregorywest@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/robertgregorywest/intervals-icu-coach"
  },
  "license": "MIT",
  "compatibility": {
    "runtimes": {
      "node": ">=20.0.0"
    }
  }
}
