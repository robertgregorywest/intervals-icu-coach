  "cards": [
    {
      "dot": "emerald",
      "title": "Deep core",
      "items": [
        "Athlete anchors: the only reader of FTP, MAP and zones; consumers take one snapshot()",
        "Prescription: the only parse → Planned steps pipeline; execution review, training load, scheduling and the library all read it",
        "Deep modules expose an interface + factory; nothing outside imports past index.ts"
      ]
    },
    {
      "dot": "violet",
      "title": "Deep modules",
      "items": [
        "Workout scheduling: every calendar write, plus the update_event structure guard",
        "Execution review: step lens, band lens and digest over paired sessions",
        "Training load: week summary, middle-band trend and forecast in one module",
        "Coaching context, Power profile: read anchors; Track and Activity analysis stand apart"
      ]
    },
    {
      "dot": "cyan",
      "title": "Edges",
      "items": [
        "Tool registry → both adapters; handlers only shape responses",
        "Services (composition root) wires; forwards nothing"
      ]
    },
    {
      "dot": "amber",
      "title": "Shallow by design",
      "items": [
        "Five API wrappers are thin CRUD over HttpClient; the FIT codec is pure",
        "Services depend on their interfaces, never on HTTP; only the library also calls HttpClient directly",
        "Dashed edges: read-only dependency on a wrapper"
      ]
    }
  ]
