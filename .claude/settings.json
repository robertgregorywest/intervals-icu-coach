{
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    }
  },
  "enabledPlugins": {
    "example-skills@anthropic-agent-skills": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] && [ ! -d \"$CLAUDE_PROJECT_DIR/node_modules\" ] && cd \"$CLAUDE_PROJECT_DIR\" && npm ci; exit 0"
          }
        ]
      }
    ]
  }
}
