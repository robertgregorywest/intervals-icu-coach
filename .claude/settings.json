{
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    }
  },
  "enabledPlugins": {
    "example-skills@anthropic-agent-skills": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "d=\"$CLAUDE_PROJECT_DIR\"; [ -f \"$d/package.json\" ] || d=\"$d/intervals-icu-coach\"; [ -f \"$d/.claude/hooks/session-start.sh\" ] && bash \"$d/.claude/hooks/session-start.sh\" \"$d\"; exit 0"
          }
        ]
      }
    ]
  }
}
