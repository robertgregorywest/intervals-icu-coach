{
  "name": "intervals-icu-mcp",
  "version": "0.7.0",
  "description": "MCP server for the Intervals.icu API",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/mcp/stdio.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:manifest": "tsx scripts/check-manifest.ts",
    "mcpb:pack": "mcpb pack",
    "prepare": "husky",
    "sandcastle": "npx tsx .sandcastle/main.ts",
    "eval:skills": "tsx evals/skills/run.ts",
    "eval:capture": "tsx evals/skills/capture.ts",
    "eval:compare": "tsx evals/skills/compare.ts",
    "eval:cases": "tsx evals/skills/cases.ts",
    "eval:grade": "tsx evals/skills/grade.ts",
    "eval:typecheck": "tsc --noEmit -p evals/skills"
  },
  "keywords": [
    "intervals-icu",
    "cycling",
    "training",
    "api",
    "mcp",
    "model-context-protocol"
  ],
  "author": "Rob West <robertgregorywest@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertgregorywest/intervals-icu-mcp.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^17.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.6.5",
    "@types/node": "^22.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "tsx": "^4.0.0",
    "typescript": "^7.0.0",
    "vitest": "^2.0.0"
  }
}
