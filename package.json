{
  "name": "intervals-icu-coach",
  "version": "0.8.0",
  "description": "MCP server, CLI and coaching skills for Intervals.icu",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/mcp/stdio.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "check:manifest": "tsx scripts/check-manifest.ts",
    "check:imports": "tsx scripts/check-imports.ts",
    "mcpb:pack": "mcpb pack",
    "prepare": "husky",
    "eval:skills": "tsx evals/skills/run.ts",
    "eval:capture": "tsx evals/skills/capture.ts",
    "eval:compare": "tsx evals/skills/compare.ts",
    "eval:cases": "tsx evals/skills/cases.ts",
    "eval:grade": "tsx evals/skills/grade.ts"
  },
  "keywords": [
    "intervals-icu",
    "cycling",
    "training",
    "api",
    "mcp",
    "model-context-protocol"
  ],
  "author": "Rob West <robertgregorywest@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertgregorywest/intervals-icu-coach.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.270",
    "@types/node": "^22.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "tsx": "^4.0.0",
    "typescript": "^7.0.0",
    "vitest": "^2.0.0",
    "yaml": "^2.9.1"
  }
}
