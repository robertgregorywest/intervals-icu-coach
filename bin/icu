#!/usr/bin/env -S npx tsx
import "dotenv/config";
import { createServices } from "../src/index.js";
import { evalServicesOptions } from "../src/cassette.js";
import { runCli } from "../src/cli/main.js";

await runCli(
  process.argv.slice(2),
  () =>
    createServices({
      apiKey: process.env.INTERVALS_API_KEY ?? "",
      athleteId: process.env.INTERVALS_ATHLETE_ID,
      // Record/replay and a pinned "today" for skill evals; no-op when unset.
      ...evalServicesOptions(process.env),
    }),
  {
    stdout: (s) => process.stdout.write(s + "\n"),
    stderr: (s) => process.stderr.write(s + "\n"),
    exit: (code) => process.exit(code),
    isTTY: Boolean(process.stdout.isTTY),
  }
);
